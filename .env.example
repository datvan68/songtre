# ==========================================
# SONGTRENSG - Environment Configuration
# Copy this file to .env and fill real values.
# NEVER commit .env or smtp_secret.php
# ==========================================

# ---------- Database ----------
DB_HOST=localhost
DB_NAME=songtrensg_doanthanhnien
DB_USER=your_db_user
DB_PASS=your_strong_db_password

# ---------- Application ----------
# ENVIRONMENT: development | production
ENVIRONMENT=production
APP_ENV=production

# Full base URL (with trailing slash)
BASE_URL=https://songtre.namsaigon.edu.vn/

# ---------- Default Admin (for initial login / emergency) ----------
# This is used as a backdoor in views/auth.php.
# After first deploy, REMOVE or change these and delete the backdoor code if not needed.
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ChangeMeStrongPass123!

# ---------- Google Drive (Service Account) ----------
# Place the real service-account.json in public_html/config/
# (it is gitignored). Do NOT put JSON content here.
GOOGLE_DRIVE_ENABLED=true

# ---------- SMTP (passwords are stored encrypted in DB `system_smtp_settings`) ----------
# The encryption key lives in public_html/config/smtp_secret.php (gitignored, must exist on server)
# You can manage SMTP settings via the app UI (usually under admin).
# These are optional fallbacks if you want to pre-seed via env in future.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASS is NOT stored here in plain text. Use the app's encrypted storage.
SMTP_ENCRYPTION=tls   # tls or ssl
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Doan Thanh Nien

# ---------- Optional: Other integrations ----------
# ZALO_OA_ACCESS_TOKEN=
# ZALO_OA_REFRESH_TOKEN=

# ---------- Security / Misc ----------
# SESSION_LIFETIME=0
# RATE_LIMIT_PAGE_VIEW=300,60

# ---------- Docker / Local only (do not use these passwords in production) ----------
# These are for docker-compose.yml local dev only.
# MYSQL_ROOT_PASSWORD=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...